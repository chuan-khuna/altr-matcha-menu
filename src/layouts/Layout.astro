---
import '@/styles/globals.css';
import FontLoader from '@/components/FontLoader.astro';
import Footer from '@/components/Footer.astro';
import { getAnnouncement } from '@/lib/announcement';

interface Props {
  title?: string;
  description?: string;
  /** `false` for a page that stands on its own — the menu board. */
  footer?: boolean;
}

const {
  footer = true,
  title = 'ALTR — Specialty Matcha Cafe',
  description = 'Single-cultivar and carefully blended matcha, sourced directly from Japanese farms and served with precision.',
} = Astro.props;

/* --nav-h counts the announcement strip; with no notice live the strip is not
   rendered, so its height comes out of every offset taken off --nav-h. */
const announcement = await getAnnouncement();
---
<!doctype html>
<html lang="en" style={announcement ? undefined : '--announce-h: 0rem'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <FontLoader />
  </head>
  <body>
    <slot />
    {footer && <Footer />}

    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.fade-up');
        if (!('IntersectionObserver' in window) || els.length === 0) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      /* Brockmann optical alignment — put display INK (not its box) on the
         column line. Large/italic glyphs carry a side-bearing, so a headline
         whose box is on the line still reads as misaligned. Measure the
         actually-loaded font's actualBoundingBoxLeft and nudge marginLeft.
         Runs after fonts load and on resize (fluid clamp type changes size). */
      (() => {
        const SEL = '[data-optical]';
        const cvs = document.createElement('canvas');
        const ctx = cvs.getContext('2d');
        const apply = () => {
          if (!ctx) return;
          document.querySelectorAll(SEL).forEach((el) => {
            el.style.marginLeft = '0px';
            const cs = getComputedStyle(el);
            let ch = (el.textContent || '').trim().charAt(0);
            if (!ch) return;
            if (cs.textTransform === 'uppercase') ch = ch.toUpperCase();
            ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
            ctx.textAlign = 'left';
            const abl = ctx.measureText(ch).actualBoundingBoxLeft;
            if (isFinite(abl)) el.style.marginLeft = abl.toFixed(2) + 'px';
          });
        };
        const run = () => requestAnimationFrame(apply);
        run();
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(run);
        let t;
        window.addEventListener('resize', () => {
          clearTimeout(t);
          t = setTimeout(run, 150);
        });
      })();
    </script>
  </body>
</html>
