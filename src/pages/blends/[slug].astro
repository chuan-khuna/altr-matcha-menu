---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

export async function getStaticPaths() {
  const blends = await getCollection('blends');
  return blends.map((blend) => ({
    params: { slug: blend.id },
    props: { blend },
  }));
}

interface Props { blend: CollectionEntry<'blends'>; }
const { blend } = Astro.props;
const { Content } = await render(blend);
const d = blend.data;

const formatPrice = (n: number) => `฿${n}`;

const specRows = [
  { label: 'Cultivar', value: d.info.cultivarType },
  { label: 'Origin',   value: d.info.origin },
  { label: 'Shading',  value: d.info.shading },
  ...(d.info.harvest    ? [{ label: 'Harvest',    value: d.info.harvest    }] : []),
  ...(d.info.processing ? [{ label: 'Processing', value: d.info.processing }] : []),
];
---
<Layout title={`${d.name} — ALTR`} description={`${d.name} · ${d.category} · ${d.origin.region}, ${d.origin.prefecture}`}>
  <Nav showBack />
  <main class="page-gutter blend">
    <div class="blend__inner">
      <header class="blend__head fade-up">
        <p class="eyebrow">{d.category}</p>
        <h1 class="blend__name">{d.name}</h1>
        <p class="blend__origin mono">
          {d.origin.region}, {d.origin.prefecture}
        </p>
      </header>

      <div class="blend__notes fade-up">
        <p class="blend__notes-label mono">Cupping notes</p>
        <ul class="blend__notes-list mono" role="list">
          {d.cuppingNotes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      </div>

      <div class="blend__grid">
        <article class="blend__story fade-up">
          <p class="blend__story-label mono">The blend</p>
          <div class="blend__story-body">
            <Content />
          </div>
        </article>

        <aside class="blend__side">
          <div class="blend__spec fade-up">
            <p class="blend__side-label mono">Specifications</p>
            <dl class="blend__spec-list mono">
              {specRows.map((row) => (
                <div class="blend__spec-row">
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="blend__drinks fade-up">
            <p class="blend__side-label mono">Available as</p>
            <ul class="blend__drinks-list mono" role="list">
              {d.drinks.map((drink) => (
                <li>
                  <span>{drink.name}</span>
                  <span class="blend__drinks-dots" aria-hidden="true"></span>
                  <span class="blend__drinks-price">{formatPrice(drink.price)}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>

      <a href="/#menu" class="blend__back mono">← Back to the menu</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blend {
    padding-top: calc(var(--nav-h) + var(--space-3xl));
    padding-bottom: var(--space-3xl);
  }
  .blend__inner {
    max-width: 64rem;
    margin: 0 auto;
  }
  .blend__head { margin-bottom: var(--space-2xl); }
  .blend__name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-top: var(--space-md);
  }
  .blend__origin {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: var(--space-md);
  }
  .blend__notes {
    border-top: var(--rule-ink);
    border-bottom: var(--rule-hairline);
    padding-block: var(--space-lg);
    margin-bottom: var(--space-2xl);
    display: grid;
    gap: var(--space-md);
  }
  .blend__notes-label,
  .blend__story-label,
  .blend__side-label {
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .blend__notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .blend__notes-list li {
    padding: 4px 10px;
    border: 1px solid var(--color-sand);
  }
  .blend__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
  }
  .blend__story-body {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--color-ink);
    margin-top: var(--space-md);
  }
  .blend__story-body :global(p + p) {
    margin-top: var(--space-md);
  }
  .blend__side { display: grid; gap: var(--space-2xl); }
  .blend__spec-list {
    margin: var(--space-md) 0 0;
    display: grid;
    gap: 0;
    font-size: var(--text-xs);
    border-top: var(--rule-hairline);
  }
  .blend__spec-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hairline);
  }
  .blend__spec-row dt {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .blend__spec-row dd {
    margin: 0;
    color: var(--color-ink);
  }
  .blend__drinks-list {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .blend__drinks-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .blend__drinks-dots {
    flex: 1;
    border-bottom: 1px dotted var(--color-sand);
    transform: translateY(-3px);
  }
  .blend__drinks-price {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .blend__back {
    display: inline-block;
    margin-top: var(--space-3xl);
    padding-top: var(--space-md);
    border-top: var(--rule-hairline);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    transition: color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }
  .blend__back:hover {
    color: var(--color-accent);
    transform: translateX(-2px);
  }

  @media (min-width: 900px) {
    .blend__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-3xl);
    }
  }
</style>
