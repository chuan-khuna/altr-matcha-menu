---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import { getSeasons, seasonLayout, type Season } from "@/lib/seasonal";

/* One page per row in seasonal.json that has a component to render it. A row
   without one is dropped by getSeasons(), so the archive never links to a 404. */
export async function getStaticPaths() {
  const seasons = await getSeasons();
  return seasons.map((season) => ({
    params: { slug: season.data.slug },
    props: { season },
  }));
}

interface Props {
  season: Season;
}
const { season } = Astro.props;
const { title, display, description } = season.data;

/* Non-null: getStaticPaths only emits slugs that resolve to a component. */
const SeasonMenu = seasonLayout(season.data.slug)!;
---

<Layout
  title={`${title} — Seasonal Menu — ALTR`}
  description={description ?? `${title}, ${display} — a seasonal menu at ALTR.`}
>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Nav showBack />
  <main
    id="main-content"
    tabindex="-1"
    class="page-gutter pt-[calc(var(--nav-h)+3rem)] pb-24"
  >
    {/* The page measure, so a season reads at the same width here as it does
        on the landing page, and the nav above it ends on the same vertical. */}
    <div class="mx-auto max-w-[var(--content-max)]">
      <SeasonMenu season={season} headingLevel="h1" />
    </div>
  </main>
</Layout>

<style>
  .skip-link {
    position: absolute;
    top: 0;
    left: 1rem;
    z-index: 9999;
    padding: 0.5rem 1rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    transform: translateY(-100%);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
