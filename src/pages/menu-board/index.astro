---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import MenuBoardTable from "@/components/menu-board/MenuBoardTable.astro";
import MenuBoardSweetness from "@/components/menu-board/MenuBoardSweetness.astro";
import { getMenuBoard } from "@/lib/menu-board";

/* The whole menu on one screen — the counter board, not the reading copy. No
   nav, no footer, no story: a picture per block and a record per blend. The
   same blocks, one to an A4 sheet, are at /menu-board/print. */

const { seasonal, standing, sweetnessFor } = await getMenuBoard();

/* Widest each picture is drawn, so Astro emits sized images rather than the
   originals: the season cover's cap (36rem) and the category photograph's
   column beside its table (14rem). Below 80rem the photograph runs full width. */
const COVER_IMAGE_PX = 576;
const CATEGORY_IMAGE_PX = 224;
---

<Layout
  title="Menu at a glance — ALTR"
  description="The whole ALTR menu on one page — every blend, every price."
  footer={false}
>
  <main class="page-gutter pt-12 pb-16">
    <div class="mx-auto max-w-[120rem]">
      <h1
        data-optical
        class="display mb-10 text-3xl italic leading-tight tracking-snug text-ink"
      >
        Menu
      </h1>

      {/* Season on the left, the standing menu on the right and running on
          down its own column. With no season on, the standing menu takes both
          columns and flows across them; a block never splits between two. */}
      <div
        class:list={[
          seasonal.length > 0
            ? "grid gap-y-14 min-[62rem]:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] min-[62rem]:items-start min-[62rem]:gap-x-16"
            : "min-[62rem]:columns-2 min-[62rem]:gap-x-16",
        ]}
      >
        {seasonal.length > 0 && (
          <div class="flex flex-col gap-y-14">
            {seasonal.map(({ table, picture, story }) => (
              <div>
                <MenuBoardTable {...table} />
                {/* The paragraph the season's own page opens on. */}
                {story && (
                  <p class="mt-6 max-w-[52ch] font-sans text-base leading-relaxed text-ink">
                    {story}
                  </p>
                )}
                {/* The season's own cover, kept whole — no crop, no frame. */}
                {picture && (
                  <Image
                    src={picture.image}
                    alt={picture.alt}
                    widths={[COVER_IMAGE_PX, COVER_IMAGE_PX * 2]}
                    sizes="(min-width: 36rem) 36rem, 100vw"
                    loading="lazy"
                    decoding="async"
                    class="mt-8 w-full max-w-[36rem] bg-paper-2"
                  />
                )}
              </div>
            ))}
          </div>
        )}

        <div class="flex flex-col gap-y-14 min-[62rem]:block min-[62rem]:[&>*+*]:mt-14">
          {standing.map(({ table, picture }) => (
            /* Photograph beside the table from 80rem, above it below that. */
            <div
              class:list={[
                "break-inside-avoid",
                picture &&
                  "grid gap-y-6 min-[80rem]:grid-cols-[14rem_minmax(0,1fr)] min-[80rem]:items-start min-[80rem]:gap-x-10",
              ]}
            >
              {picture && (
                <Image
                  src={picture.image}
                  alt={picture.alt}
                  widths={[CATEGORY_IMAGE_PX, CATEGORY_IMAGE_PX * 2, 960]}
                  sizes="(min-width: 80rem) 14rem, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full bg-paper-2 object-cover min-[80rem]:aspect-[4/5]"
                />
              )}
              <MenuBoardTable {...table} />
            </div>
          ))}
          {/* The scale for the drinks that take syrup — after the categories it
              applies to, as one more block. */}
          {sweetnessFor.length > 0 && <MenuBoardSweetness appliesTo={sweetnessFor} />}
        </div>
      </div>
    </div>
  </main>
</Layout>
