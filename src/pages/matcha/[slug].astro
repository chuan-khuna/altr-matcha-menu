---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

export async function getStaticPaths() {
  const matchas = await getCollection("matcha");
  return matchas.map((entry) => ({
    params: { slug: entry.id.split("/").at(-1) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"matcha">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const formatPrice = (n: number) => (n > 0 ? `฿${n}` : "—");

const categoryLabels: Record<string, string> = {
  clear: "Clear Matcha",
  latte: "Latte Matcha",
  powder: "Powder",
};

const menuEntries = (Object.keys(d.menus) as Array<keyof typeof d.menus>)
  .filter((k) => d.menus[k])
  .map((k) => ({
    label: categoryLabels[k],
    items: Object.entries(d.menus[k]!),
  }));

const eyebrow = menuEntries.map((e) => e.label).join(" · ");

const specRows = [
  { label: "Cultivar", value: d.info.cultivar },
  { label: "Origin", value: d.info.origin },
  { label: "Shading", value: d.info.shading },
  ...(d.info.harvest ? [{ label: "Harvest", value: d.info.harvest }] : []),
  ...(d.info.processing
    ? [{ label: "Processing", value: d.info.processing }]
    : []),
].filter((r) => r.value);
---

<Layout
  title={`${d.name} — ALTR`}
  description={`${d.name} · ${eyebrow} · ${d.info?.origin ?? ""}`}
>
  <Nav showBack />
  <main
    class="page-gutter pb-20 pt-[calc(var(--nav-h)+5rem)]"
  >
    <div class="mx-auto max-w-[64rem]">
      <header class="fade-up mb-12">
        <p class="eyebrow">{eyebrow}</p>
        <h1
          class="display mt-4 text-[clamp(3rem,9vw,6.5rem)] italic leading-[0.98] tracking-[-0.02em]"
        >
          {d.name}
        </h1>
        <p
          class="mono mt-4 text-xs uppercase tracking-[0.18em] text-accent"
        >
          {
            d.info?.brand
              ? `by ${d.info.brand}${d.info.origin ? ` — ${d.info.origin}` : ""}`
              : d.info?.origin
          }
        </p>
      </header>

      <div
        class="fade-up mb-12 grid gap-4 border-b border-border border-t border-foreground py-6"
      >
        <p
          class="mono text-xs uppercase tracking-[0.16em] text-ink-muted"
        >
          Cupping notes
        </p>
        <ul
          class="mono m-0 flex list-none flex-wrap gap-2 p-0 text-sm"
          role="list"
        >
          {
            d.notes.map((n) => (
              <li class="border border-sand px-[10px] py-[4px]">{n}</li>
            ))
          }
        </ul>
      </div>

      <div
        class="grid grid-cols-1 gap-20 min-[900px]:grid-cols-[1.4fr_1fr]"
      >
        <article class="fade-up">
          <p
            class="mono text-xs uppercase tracking-[0.16em] text-ink-muted"
          >
            The blend
          </p>
          <div
            class="blend__story-body font-display mt-4 text-2xl leading-[1.45] text-ink"
          >
            <Content />
          </div>
        </article>

        <aside class="grid gap-12">
          <div class="fade-up">
            <p
              class="mono text-xs uppercase tracking-[0.16em] text-ink-muted"
            >
              Specifications
            </p>
            <dl
              class="mono mt-4 grid gap-0 border-t border-border text-xs"
            >
              {
                specRows.map((row) => (
                  <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-border py-3">
                    <dt class="uppercase tracking-[0.14em] text-ink-muted">
                      {row.label}
                    </dt>
                    <dd class="m-0 text-ink">{row.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div class="fade-up">
            <p
              class="mono text-xs uppercase tracking-[0.16em] text-ink-muted"
            >
              Available as
            </p>
            {
              menuEntries.map(({ label, items }) => (
                <div class="mt-4 first:mt-0">
                  <p class="mono mb-2 text-xs uppercase tracking-[0.12em] text-accent">
                    {label}
                  </p>
                  <ul
                    class="mono m-0 grid list-none gap-2 p-0 text-sm"
                    role="list"
                  >
                    {items.map(([name, price]) => (
                      <li class="flex items-baseline gap-2">
                        <span>{name}</span>
                        <span
                          class="flex-1 translate-y-[-3px] border-b border-dotted border-sand"
                          aria-hidden="true"
                        />
                        <span class="tabular-nums text-ink">
                          {formatPrice(price)}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </aside>
      </div>

      <a
        href="/#menu"
        class="mono mt-20 inline-block border-t border-border pt-4 text-xs uppercase tracking-[0.16em] text-ink-muted transition-all duration-150 ease-out hover:-translate-x-[2px] hover:text-accent"
        >← Back to the menu</a
      >
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blend__story-body :global(p + p) {
    margin-top: 1rem;
  }
</style>
