---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import TasteNotes from "@/components/matcha-info/TasteNotes.astro";
import Story from "@/components/matcha-info/Story.astro";
import MatchaInfo from "@/components/matcha-info/MatchaInfo.astro";
import AvailableMenu from "@/components/matcha-info/AvailableMenu.astro";
import MatchaGallery from "@/components/matcha-info/MatchaGallery.astro";

export async function getStaticPaths() {
  const matchas = await getCollection("matcha");
  return matchas.map((entry) => ({
    params: {
      slug: entry.id
        .replace(/\/index$/, "")
        .split("/")
        .at(-1),
    },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"matcha">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const categoryLabels: Record<string, string> = {
  clear: "Clear Matcha",
  latte: "Latte Matcha",
  powder: "Powder",
};

const menuEntries = (Object.keys(d.menus) as Array<keyof typeof d.menus>)
  .filter((k) => d.menus[k])
  .map((k) => ({
    label: categoryLabels[k],
    items: Object.entries(d.menus[k]!),
  }));

const eyebrow = menuEntries.map((e) => e.label).join(" · ");

const specRows = [
  { label: "Cultivar", value: d.info.cultivar },
  { label: "Origin", value: d.info.origin },
  { label: "Shading", value: d.info.shading },
  ...(d.info.harvest ? [{ label: "Harvest", value: d.info.harvest }] : []),
  ...(d.info.processing
    ? [{ label: "Processing", value: d.info.processing }]
    : []),
].filter((r) => r.value);
---

<Layout
  title={`${d.name} — ALTR`}
  description={[d.name, eyebrow, d.info?.origin].filter(Boolean).join(" · ")}
>
  <Nav showBack />
  <main class="page-gutter pb-24 pt-[calc(var(--nav-h)+5rem)]">
    <div class="mx-auto max-w-[64rem]">
      <!-- Specimen header — huge italic name -->
      <header class="fade-up mb-12 border-b border-border pb-6">
        <h1
          class="display text-[clamp(3.5rem,10vw,7.5rem)] italic leading-[0.96] tracking-[-0.02em]"
        >
          {d.name}
        </h1>
        {
          d.info?.brand && (
            <p class="mono mt-5 text-xs uppercase tracking-[0.16em] text-ink-muted">
              by {d.info.brand}
            </p>
          )
        }
      </header>

      <TasteNotes notes={d.notes} />

      <div class="mt-12 grid grid-cols-1 gap-8 min-[640px]:grid-cols-2">
        <MatchaInfo specRows={specRows} />
        <AvailableMenu menuEntries={menuEntries} />
      </div>

      <div class="mt-16 border-t border-border pt-8 grid grid-cols-1 gap-12 min-[800px]:grid-cols-[1fr_20rem] min-[1024px]:grid-cols-[1fr_26rem]">
        <Story Content={Content} />
        {
          d.gallery && d.gallery.length > 0 && (
            <aside class="gallery-aside min-[800px]:sticky min-[800px]:top-[calc(var(--nav-h)+2rem)] min-[800px]:self-start min-[800px]:max-h-[calc(100svh-var(--nav-h)-4rem)] min-[800px]:overflow-y-auto">
              <MatchaGallery items={d.gallery} />
            </aside>
          )
        }
      </div>

      <a
        href="/#menu"
        class="mono mt-16 inline-block border-t border-border pt-4 text-xs uppercase tracking-[0.16em] text-ink-muted transition-all duration-150 ease-out hover:-translate-x-[2px] hover:text-accent"
        >← Back to the menu</a
      >
    </div>
  </main>
</Layout>

<style>
  .gallery-aside {
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .gallery-aside::-webkit-scrollbar {
    width: 3px;
  }
  .gallery-aside::-webkit-scrollbar-track {
    background: transparent;
  }
  .gallery-aside::-webkit-scrollbar-thumb {
    background: var(--border);
  }
  .gallery-aside::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent);
  }
</style>
