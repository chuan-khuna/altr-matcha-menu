---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import TasteNotes from "@/components/matcha-info/TasteNotes.astro";
import Story from "@/components/matcha-info/Story.astro";
import MatchaInfo from "@/components/matcha-info/MatchaInfo.astro";
import AvailableMenu from "@/components/matcha-info/AvailableMenu.astro";
import MatchaGallery from "@/components/matcha-info/MatchaGallery.astro";
import MenuRemark from "@/components/matcha-info/MenuRemark.astro";

export async function getStaticPaths() {
  const matchas = await getCollection("matcha");
  return matchas.map((entry) => ({
    params: {
      slug: entry.id
        .replace(/\/index$/, "")
        .split("/")
        .at(-1),
    },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"matcha">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const categoryLabels: Record<string, string> = {
  clear: "Clear Matcha",
  latte: "Latte Matcha",
  powder: "Powder",
};

const menuEntries = (Object.keys(d.menus) as Array<keyof typeof d.menus>)
  .filter((k) => d.menus[k])
  .map((k) => ({
    label: categoryLabels[k],
    items: Object.entries(d.menus[k]!),
  }));

const eyebrow = menuEntries.map((e) => e.label).join(" · ");

const specRows = [
  { label: "Cultivar", value: d.info.cultivar },
  { label: "Origin", value: d.info.origin },
  { label: "Shading", value: d.info.shading },
  ...(d.info.harvest ? [{ label: "Harvest", value: d.info.harvest }] : []),
  ...(d.info.processing
    ? [{ label: "Processing", value: d.info.processing }]
    : []),
].filter((r) => r.value);
---

<Layout
  title={`${d.name} — ALTR`}
  description={[d.name, eyebrow, d.info?.origin].filter(Boolean).join(" · ")}
>
  <Nav showBack />
  <main class="page-gutter pb-24 pt-[calc(var(--nav-h)+5rem)]">
    <div class="mx-auto max-w-[var(--content-max)]">
      <!-- Specimen header — huge italic name -->
      <header class="fade-up mb-12 border-b border-border pb-6">
        <h1
          data-optical
          class="display text-display italic leading-display tracking-tight"
        >
          {d.name}
        </h1>
        {
          d.info?.brand && (
            <p class="mono mt-4 text-xs uppercase tracking-widest text-ink-muted">
              by {d.info.brand}
            </p>
          )
        }
      </header>

      <TasteNotes notes={d.notes} />

      <!-- Info / menu band — placed on the shared 12-column field grid -->
      <div class="mt-12 field-grid">
        <div class="col-span-12 min-[640px]:col-span-7">
          <MatchaInfo specRows={specRows} />
        </div>
        <div class="col-span-12 flex flex-col gap-8 min-[640px]:col-span-5">
          <AvailableMenu menuEntries={menuEntries} />
          {d.menus.latte && Object.keys(d.menus.latte).length > 0 && (
            <MenuRemark />
          )}
        </div>
      </div>

      <!-- Story / gallery band — same 12-column field grid -->
      <div class="mt-16 field-grid border-t border-border pt-8">
        <div class="col-span-12 min-[800px]:col-span-8">
          <Story Content={Content} />
        </div>
        {
          d.gallery && d.gallery.length > 0 && (
            <aside class="gallery-aside col-span-12 min-[800px]:col-span-4 min-[800px]:sticky min-[800px]:top-[calc(var(--nav-h)+2rem)] min-[800px]:self-start min-[800px]:max-h-[calc(100svh-var(--nav-h)-4rem)] min-[800px]:overflow-y-auto">
              <MatchaGallery items={d.gallery} />
            </aside>
          )
        }
      </div>

      <a
        href="/#menu"
        class="mono mt-16 inline-block border-t border-border pt-4 text-xs uppercase tracking-widest text-ink-muted transition-all duration-150 ease-out hover:-translate-x-[2px] hover:text-accent"
        >← Back to the menu</a
      >
    </div>
  </main>
</Layout>

<style>
  .gallery-aside {
    scrollbar-width: none;
  }
  .gallery-aside::-webkit-scrollbar {
    display: none;
  }
</style>
