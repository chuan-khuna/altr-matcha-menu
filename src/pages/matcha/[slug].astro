---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

export async function getStaticPaths() {
  const matchas = await getCollection("matcha");
  return matchas.map((entry) => ({
    params: { slug: entry.id.split("/").at(-1) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"matcha">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const formatPrice = (n: number) => (n > 0 ? `฿${n}` : "—");

const categoryLabels: Record<string, string> = {
  clear: "Clear Matcha",
  latte: "Latte Matcha",
  powder: "Powder",
};

const menuEntries = (Object.keys(d.menus) as Array<keyof typeof d.menus>)
  .filter((k) => d.menus[k])
  .map((k) => ({
    label: categoryLabels[k],
    items: Object.entries(d.menus[k]!),
  }));

const eyebrow = menuEntries.map((e) => e.label).join(" · ");

const specRows = [
  { label: "Cultivar", value: d.info.cultivar },
  { label: "Origin", value: d.info.origin },
  { label: "Shading", value: d.info.shading },
  ...(d.info.harvest ? [{ label: "Harvest", value: d.info.harvest }] : []),
  ...(d.info.processing
    ? [{ label: "Processing", value: d.info.processing }]
    : []),
].filter((r) => r.value);
---

<Layout
  title={`${d.name} — ALTR`}
  description={`${d.name} · ${eyebrow} · ${d.info?.origin ?? ""}`}
>
  <Nav showBack />
  <main class="page-gutter pb-24 pt-[calc(var(--nav-h)+5rem)]">
    <div class="mx-auto max-w-[64rem]">

      <!-- Specimen header — huge italic name -->
      <header class="fade-up mb-16 border-b border-border pb-10">
        <p class="mono text-xs uppercase tracking-[0.16em] text-ink-muted">{eyebrow}</p>
        <h1 class="display mt-4 text-[clamp(3.5rem,10vw,7.5rem)] italic leading-[0.96] tracking-[-0.02em]">
          {d.name}
        </h1>
        {(d.info?.brand || d.info?.origin) && (
          <p class="mono mt-5 text-xs uppercase tracking-[0.16em] text-ink-muted">
            {d.info?.brand ? `by ${d.info.brand}${d.info.origin ? ` — ${d.info.origin}` : ''}` : d.info?.origin}
          </p>
        )}
      </header>

      <!-- 01 — Cupping -->
      <div class="fade-up grid grid-cols-1 gap-2 border-t border-border pt-6 min-[560px]:grid-cols-[8rem_1fr] min-[560px]:gap-10">
        <p class="mono text-xs uppercase tracking-[0.16em] text-ink-muted pt-[0.2rem]">01 — Cupping</p>
        <p class="mono lowercase tracking-[0.04em] text-ink-muted">{d.notes.join(' · ')}</p>
      </div>

      <!-- 02 — The blend -->
      <div class="fade-up grid grid-cols-1 gap-2 border-t border-border pt-6 mt-8 min-[560px]:grid-cols-[8rem_1fr] min-[560px]:gap-10">
        <p class="mono text-xs uppercase tracking-[0.16em] text-ink-muted pt-[0.2rem]">02 — The blend</p>
        <div class="blend__story-body font-sans text-base leading-[1.7] text-ink">
          <Content />
        </div>
      </div>

      <!-- 03 + 04 side-by-side on wider screens -->
      <div class="mt-8 grid grid-cols-1 gap-8 min-[640px]:grid-cols-2">
        <!-- 03 — Spec -->
        <div class="fade-up border-t border-border pt-6">
          <p class="mono text-xs uppercase tracking-[0.16em] text-ink-muted mb-4">03 — Spec</p>
          <dl class="mono grid gap-0 text-xs">
            {specRows.map((row) => (
              <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-border py-3">
                <dt class="uppercase tracking-[0.14em] text-ink-muted">{row.label}</dt>
                <dd class="m-0 text-sm text-ink">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- 04 — Serve -->
        <div class="fade-up border-t border-border pt-6">
          <p class="mono text-xs uppercase tracking-[0.16em] text-ink-muted mb-4">04 — Serve</p>
          {menuEntries.map(({ label, items }) => (
            <div class="mt-4 first:mt-0">
              <p class="mono mb-2 text-xs uppercase tracking-[0.12em] text-accent">{label}</p>
              <ul class="mono m-0 grid list-none gap-2 p-0 text-sm" role="list">
                {items.map(([name, price]) => (
                  <li class="flex items-baseline gap-2">
                    <span>{name}</span>
                    <span class="flex-1 translate-y-[-3px] border-b border-dotted border-sand" aria-hidden="true" />
                    <span class="tabular-nums text-ink">{formatPrice(price)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <a
        href="/#menu"
        class="mono mt-16 inline-block border-t border-border pt-4 text-xs uppercase tracking-[0.16em] text-ink-muted transition-all duration-150 ease-out hover:-translate-x-[2px] hover:text-accent"
      >← Back to the menu</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blend__story-body :global(p + p) {
    margin-top: 1rem;
  }
</style>
