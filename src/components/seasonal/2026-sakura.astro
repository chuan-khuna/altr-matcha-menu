---
import { Image } from "astro:assets";
import type { SeasonLayoutProps } from "@/lib/seasonal";
import SeasonHead from "@/components/seasonal/ui/SeasonHead.astro";
import MenuGridTile from "@/components/matcha-info/ui/MenuGridTile.astro";
import cover from "@/components/seasonal/2026-sakura/cover.jpg";
import sparkling from "@/components/seasonal/2026-sakura/matcha-sparkling-sakura.jpg";
import float from "@/components/seasonal/2026-sakura/sakura-float.jpg";
import monaka from "@/components/seasonal/2026-sakura/sakura-monaka.jpg";

type Props = SeasonLayoutProps;
const { season, headingLevel = "h2" } = Astro.props;

/* Spring 2026 — a cover the width of the measure, then the three things that
   were on it. Prices are placeholders. */
const items = [
  {
    name: "Matcha Sparkling Sakura",
    prices: [["single", 220]] as [string, number][],
    description: "Usucha poured over sparkling sakura, unstirred",
    notes: ["salted blossom", "green apple", "sea air"],
    image: sparkling,
    imageAlt:
      "Clear cup, matcha layered dark green over pink sakura sparkling and ice",
  },
  {
    name: "Sakura Float",
    prices: [["single", 240]] as [string, number][],
    description: "Sparkling sakura under a scoop of sakura gelato",
    notes: ["cherry leaf", "milk", "almond"],
    image: float,
    imageAlt:
      "Pink sparkling sakura in a clear cup with a scoop of sakura gelato on the rim",
  },
  {
    name: "Sakura Monaka",
    prices: [["single", 160]] as [string, number][],
    description: "Wafer shell stamped with a blossom, filled to order",
    image: monaka,
    imageAlt:
      "Sakura monaka on a small white plate, wafer shell stamped with a cherry blossom",
  },
];

/* Widest a tile gets: the measure, three across, with no photo rail beside it
   the way the standing menu has. */
const TILE_IMAGE_PX = 340;
---

<article aria-labelledby={`seasonal-${season.data.slug}-label`}>
  <SeasonHead
    season={season}
    headingLevel={headingLevel}
    linked={headingLevel !== "h1"}
  />

  {/* The cover carries the season on its own — no frame, no radius, the way the
      category photographs sit on the paper. Letterboxed from 46rem because the
      source is a macro: the green-over-pink boundary is what has to survive the
      crop, so the frame is held above centre. */}
  <Image
    src={cover}
    alt="Matcha settling through sparkling sakura, salted blossom suspended in the bubbles"
    width={1240}
    loading="lazy"
    decoding="async"
    class="fade-up mt-8 aspect-[4/5] w-full bg-paper-2 object-cover object-[center_38%] min-[46rem]:aspect-[16/7]"
  />

  <p
    class="fade-up mt-8 max-w-[52ch] font-sans text-base leading-relaxed text-ink"
  >
    Cherry season is short and we do not stretch it. The blossoms are salt-cured,
    not flavoured — they go into the syrup whole and stay in the cup, so the
    drink turns rounder and saltier the longer you sit with it.
  </p>

  <ul
    class="m-0 mt-12 grid list-none grid-cols-2 gap-x-6 gap-y-10 p-0 min-[46rem]:grid-cols-3"
    role="list"
  >
    {items.map((item) => <MenuGridTile {...item} imageWidth={TILE_IMAGE_PX} />)}
  </ul>
</article>
