---
import { Font } from 'astro:assets';
---

<!-- Preload body font (Hanken Grotesk) — used above the fold -->
<Font cssVariable="--font-hanken-grotesk" preload />
<!-- Display font loaded normally — headings only -->
<Font cssVariable="--font-playfair-display" />
<!-- Mono font — data, labels, metadata -->
<Font cssVariable="--font-inconsolata" />
