---
import { Font } from 'astro:assets';
---

<!-- Preload body font (Lato) — used above the fold -->
<Font cssVariable="--font-lato" preload />
<!-- Display serif — hero and large headings (h1, h2) -->
<Font cssVariable="--font-dm-serif-display" />
<!-- Text serif — subheadings (h3, h4) -->
<Font cssVariable="--font-dm-serif-text" />
