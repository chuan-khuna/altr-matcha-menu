---
import { Image } from "astro:assets";

interface Props {
  name: string;
  /** Variant label → price, in written order. */
  prices: [string, number][];
  description?: string;
  notes?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  /**
   * Widest this tile gets, in px — Astro emits at that width rather than at the
   * source resolution. The default is the entries column at the 62rem measure,
   * three across, beside the category photo rail. A grid with no rail beside it
   * (a seasonal menu) gets wider tiles and passes its own number.
   */
  imageWidth?: number;
  /**
   * A page of its own for this entry. Present → the photograph and the name are
   * one link to it; absent → the tile is plain, which is what a dessert (no
   * page behind it) gets.
   */
  href?: string;
}

const {
  name,
  prices,
  description,
  notes,
  image,
  imageAlt = "",
  imageWidth = 240,
  href,
} = Astro.props;

const formatPrice = (n: number) => (n > 0 ? n.toLocaleString("en-US") : "—");

/* One way to buy it — the label is the dessert's name, so printing it again
   under the figure says nothing. Several, and every label has to show. */
const single = prices.length === 1;

/* Photograph and name go inside one element so a linked tile is one target and
   one tab stop, not two links to the same page. */
const Frame = href ? "a" : "div";
---

<li class="fade-up min-w-0">
  <Frame class:list={["group block", href && "cursor-pointer"]} href={href}>
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt}
          width={imageWidth}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
          class:list={[
            "aspect-square w-full bg-paper-2 object-cover",
            href && "transition-opacity duration-150 ease-out group-hover:opacity-90",
          ]}
        />
      ) : (
        /* Held open so a dessert without a photograph keeps the grid's rhythm
           instead of riding up level with its neighbours' captions. */
        <div class="aspect-square w-full bg-paper-2" aria-hidden="true" />
      )
    }

    {/* The hover states only exist on a tile that goes somewhere — a dessert
        has no page behind it, and lighting up under the cursor would promise
        one. */}
    <p
      class:list={[
        "mono mt-3 text-base leading-tight tracking-snug text-ink",
        href && "transition-colors duration-150 ease-out group-hover:text-accent",
      ]}
    >
      {name}
    </p>
  </Frame>

  {
    single ? (
      <p class="mono mt-1 text-sm tabular-nums text-ink">{formatPrice(prices[0][1])}</p>
    ) : (
      /* One row per price — label left, figure right against the tile edge, so a
         dessert sold three ways reads as a short column instead of a wrapped
         line. */
      <dl class="mono mt-1 grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-0.5 text-sm">
        {prices.map(([label, price]) => (
          <Fragment>
            <dt class="min-w-0 text-ink-muted">{label}</dt>
            <dd class="text-right tabular-nums text-ink">{formatPrice(price)}</dd>
          </Fragment>
        ))}
      </dl>
    )
  }

  {
    description && (
      <p class="mono mt-2 text-sm leading-snug text-ink-muted">{description}</p>
    )
  }

  {
    notes && notes.length > 0 && (
      <p class="mono mt-2 text-sm leading-snug text-ink-muted" aria-label="Tasting notes">
        {notes.join(" · ")}
      </p>
    )
  }
</li>
