---
import type { ComponentProps } from "astro/types";

interface Props {
  Content: (_props: ComponentProps<"div">) => any;
}
const { Content } = Astro.props;
---

<div class="fade-up">
  <div class="blend__story-body font-sans text-base leading-relaxed text-ink max-w-[52ch]">
    <Content />
  </div>
</div>

<style>
  .blend__story-body :global(p + p) {
    margin-top: 1rem;
  }
</style>
