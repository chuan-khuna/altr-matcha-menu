---
interface SpecRow {
  label: string;
  value: string;
}

interface Props {
  specRows: SpecRow[];
}
const { specRows } = Astro.props;
---

<!-- 03 — Spec -->
<div class="fade-up border-t border-border pt-6">
  <p class="mono text-xs uppercase tracking-[0.16em] text-ink-muted mb-4">03 — Spec</p>
  <dl class="mono grid gap-0 text-xs">
    {specRows.map((row) => (
      <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-border py-3">
        <dt class="uppercase tracking-[0.14em] text-ink-muted">{row.label}</dt>
        <dd class="m-0 text-sm text-ink">{row.value}</dd>
      </div>
    ))}
  </dl>
</div>
