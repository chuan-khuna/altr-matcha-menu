---
interface SpecRow {
  label: string;
  value: string;
}

interface Props {
  specRows: SpecRow[];
}
const { specRows } = Astro.props;
---

<div class="fade-up">
  <dl class="mono grid gap-0 text-xs">
    {specRows.map((row) => (
      <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-border/50 py-3">
        <dt class="uppercase tracking-[0.14em] text-ink-muted">{row.label}</dt>
        <dd class="m-0 text-sm text-ink">{row.value}</dd>
      </div>
    ))}
  </dl>
</div>
