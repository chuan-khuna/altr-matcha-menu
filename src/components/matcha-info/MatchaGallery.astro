---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  image: ImageMetadata;
  description?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="fade-up" data-gallery>
      <!-- image stage with overlaid nav -->
      <div class="relative">
        {items.map((item, i) => (
          <figure
            class="m-0 block"
            data-slide
            aria-hidden={i !== 0 ? "true" : undefined}
            style={i !== 0 ? "display:none" : ""}
          >
            <Image
              src={item.image}
              alt={item.description ?? ""}
              class="aspect-square w-full object-cover"
            />
          </figure>
        ))}

        {items.length > 1 && (
          <>
            <button
              class="gallery-btn absolute left-0 top-1/2 -translate-y-1/2"
              data-prev
              aria-label="Previous image"
            >
              ‹
            </button>
            <button
              class="gallery-btn absolute right-0 top-1/2 -translate-y-1/2"
              data-next
              aria-label="Next image"
            >
              ›
            </button>
          </>
        )}
      </div>

      <!-- caption + counter -->
      <div class="mt-3 flex items-baseline justify-between gap-4 border-t border-border pt-3">
        <p class="mono min-h-[1em] text-xs tracking-[0.08em] text-ink-muted" data-caption>
          {items[0].description ?? ""}
        </p>
        {items.length > 1 && (
          <p class="mono shrink-0 text-xs tracking-[0.12em] text-ink-muted opacity-50" data-counter>
            1 / {items.length}
          </p>
        )}
      </div>
    </div>
  )
}

<style>
  .gallery-btn {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-ink);
    background: color-mix(in oklch, var(--color-paper) 80%, transparent);
    border: none;
    padding: 0.6rem 0.55rem 0.5rem;
    cursor: pointer;
    opacity: 0.5;
    transition:
      opacity 150ms ease,
      color 150ms ease,
      background 150ms ease;
  }
  .gallery-btn:hover {
    opacity: 1;
    color: var(--color-accent);
    background: color-mix(in oklch, var(--color-paper) 95%, transparent);
  }
</style>

<script>
  document.querySelectorAll("[data-gallery]").forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-slide]"));
    const caption = gallery.querySelector("[data-caption]");
    const counter = gallery.querySelector("[data-counter]");
    const prev = gallery.querySelector<HTMLButtonElement>("[data-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-next]");

    if (slides.length <= 1) return;

    const captions = slides.map((s) => s.querySelector("img")?.alt ?? "");
    let current = 0;

    function go(index: number) {
      slides[current].style.display = "none";
      slides[current].setAttribute("aria-hidden", "true");
      current = ((index % slides.length) + slides.length) % slides.length;
      slides[current].style.display = "";
      slides[current].removeAttribute("aria-hidden");
      if (caption) caption.textContent = captions[current];
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    }

    prev?.addEventListener("click", () => go(current - 1));
    next?.addEventListener("click", () => go(current + 1));
  });
</script>
