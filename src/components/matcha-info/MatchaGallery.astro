---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  image: ImageMetadata;
  description?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="fade-up flex flex-col gap-4">
      {items.map((item) => (
        <figure class="group m-0">
          <div class="overflow-hidden">
            <Image
              src={item.image}
              alt={item.description ?? ""}
              class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
            />
          </div>
          {item.description && (
            <figcaption class="mono mt-2 text-xs tracking-[0.08em] text-ink-muted">
              {item.description}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}
