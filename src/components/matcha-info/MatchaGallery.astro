---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  image: ImageMetadata;
  description?: string;
}

interface Props {
  items: GalleryItem[];
  /**
   * Rendered width in px. Set it where the gallery sits in a narrow column (the
   * menu) so Astro emits a sized image instead of the full-resolution original.
   * Omitted → full size, which is what the blend pages want.
   */
  imageWidth?: number;
  /**
   * `contain` (default) letterboxes the whole frame — right for the cut-out
   * product shots on the blend pages. `cover` fills the square, which is what
   * photographs with their own background need so no white box shows against
   * the paper.
   */
  fit?: "contain" | "cover";
  /**
   * Scroll-triggered fade-in. Turn it OFF inside a `position: sticky` rail: the
   * rail can already be pinned when it first enters the viewport, and a pinned
   * element that starts at `opacity: 0` has no reliable moment to fade in.
   */
  animate?: boolean;
}

const { items, imageWidth, fit = "contain", animate = true } = Astro.props;
---

{
  items.length > 0 && (
    <div class:list={[{ "fade-up": animate }]} data-gallery>
      <!-- image stage — stacked slides, crossfade transition -->
      <div class="gallery-stage">
        {items.map((item, i) => (
          <figure
            class:list={["gallery-slide m-0", { "is-active": i === 0 }]}
            data-slide
            aria-hidden={i !== 0 ? "true" : undefined}
          >
            <Image
              src={item.image}
              alt={item.description ?? ""}
              class:list={["h-full w-full", fit === "cover" ? "object-cover" : "object-contain"]}
              quality={90}
              {...(imageWidth ? { width: imageWidth, densities: [1, 2] } : {})}
            />
          </figure>
        ))}
      </div>

      <!-- caption + nav -->
      <div class="mt-4 flex items-start justify-between gap-4 border-t border-border pt-4">
        <p class="mono min-h-[1em] text-xs tracking-wide text-ink-muted" data-caption>
          {items[0].description ?? ""}
        </p>
        {items.length > 1 && (
          <div class="flex shrink-0 items-center gap-2">
            <button class="gallery-btn" data-prev aria-label="Previous image">‹</button>
            <span class="mono text-xs tracking-wider text-ink-muted opacity-50" data-counter>
              1 / {items.length}
            </span>
            <button class="gallery-btn" data-next aria-label="Next image">›</button>
          </div>
        )}
      </div>
    </div>
  )
}

<style>
  .gallery-stage {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
  }

  .gallery-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gallery-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-slide {
      transition-duration: 0.01ms;
    }
  }

  .gallery-btn {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: 1;
    color: var(--color-ink-muted);
    background: none;
    border: none;
    padding: 0 0.15rem;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 150ms ease, color 150ms ease;
  }
  .gallery-btn:hover {
    opacity: 1;
    color: var(--color-accent);
  }
</style>

<script>
  document.querySelectorAll("[data-gallery]").forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-slide]"));
    const caption = gallery.querySelector("[data-caption]");
    const counter = gallery.querySelector("[data-counter]");
    const prev = gallery.querySelector<HTMLButtonElement>("[data-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-next]");

    if (slides.length <= 1) return;

    const SLIDE_INTERVAL_MS = 5000; // time each slide is shown before auto-advancing
    const captions = slides.map((s) => s.querySelector("img")?.alt ?? "");
    let current = 0;

    function go(index: number) {
      slides[current].classList.remove("is-active");
      slides[current].setAttribute("aria-hidden", "true");
      current = ((index % slides.length) + slides.length) % slides.length;
      slides[current].classList.add("is-active");
      slides[current].removeAttribute("aria-hidden");
      if (caption) caption.textContent = captions[current];
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    }

    prev?.addEventListener("click", () => { resetTimer(); go(current - 1); });
    next?.addEventListener("click", () => { resetTimer(); go(current + 1); });

    let timer = setInterval(() => go(current + 1), SLIDE_INTERVAL_MS);
    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(() => go(current + 1), SLIDE_INTERVAL_MS);
    }
  });
</script>
