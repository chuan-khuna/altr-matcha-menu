---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  image: ImageMetadata;
  description?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="fade-up" data-gallery>
      <!-- slides -->
      <div class="relative overflow-hidden">
        {items.map((item, i) => (
          <figure
            class="gallery__slide m-0"
            data-slide
            aria-hidden={i !== 0 ? "true" : undefined}
            style={i !== 0 ? "display:none" : ""}
          >
            <Image
              src={item.image}
              alt={item.description ?? ""}
              class="aspect-square w-full object-cover"
            />
          </figure>
        ))}
      </div>

      <!-- controls -->
      <div class="mt-3 flex items-center gap-3 border-t border-border pt-3">
        <button
          class="mono shrink-0 text-sm tracking-[0.1em] text-ink-muted transition-colors duration-150 hover:text-accent disabled:opacity-25"
          data-prev
          aria-label="Previous image"
        >
          ←
        </button>

        <div class="mono min-h-[1em] flex-1 text-center text-xs tracking-[0.08em] text-ink-muted" data-caption>
          {items[0].description ?? ""}
        </div>

        <button
          class="mono shrink-0 text-sm tracking-[0.1em] text-ink-muted transition-colors duration-150 hover:text-accent disabled:opacity-25"
          data-next
          aria-label="Next image"
        >
          →
        </button>
      </div>

      {items.length > 1 && (
        <p class="mono mt-2 text-center text-xs tracking-[0.12em] text-ink-muted opacity-60" data-counter>
          1 / {items.length}
        </p>
      )}
    </div>
  )
}

<script>
  document.querySelectorAll("[data-gallery]").forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-slide]"));
    const caption = gallery.querySelector("[data-caption]");
    const counter = gallery.querySelector("[data-counter]");
    const prev = gallery.querySelector<HTMLButtonElement>("[data-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-next]");

    if (slides.length <= 1) {
      prev?.remove();
      next?.remove();
      return;
    }

    const captions = slides.map((s) => s.querySelector("img")?.alt ?? "");
    let current = 0;

    function go(index: number) {
      slides[current].style.display = "none";
      slides[current].setAttribute("aria-hidden", "true");
      current = ((index % slides.length) + slides.length) % slides.length;
      slides[current].style.display = "";
      slides[current].removeAttribute("aria-hidden");
      if (caption) caption.textContent = captions[current];
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    }

    prev?.addEventListener("click", () => go(current - 1));
    next?.addEventListener("click", () => go(current + 1));
  });
</script>
