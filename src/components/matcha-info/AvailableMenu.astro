---
interface MenuEntry {
  label: string;
  items: [string, number][];
}

interface Props {
  menuEntries: MenuEntry[];
}
const { menuEntries } = Astro.props;

const formatPrice = (n: number) => (n > 0 ? n.toLocaleString() : "—");
---

{menuEntries.length > 0 && (
  <div class="fade-up">
    {menuEntries.filter(({ items }) => items.length > 0).map(({ label, items }) => (
      <div class="mt-4 first:mt-0">
        <p class="mono mb-2 text-xs uppercase tracking-wider text-accent">{label}</p>
        <ul class="mono m-0 grid list-none gap-2 p-0 text-sm" role="list">
          {items.map(([name, price]) => (
            <li class="flex items-baseline gap-2">
              <span class="leader min-w-0 flex-1 break-words">{name}</span>
              <span class="tabular-nums text-ink">{formatPrice(price)}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}
