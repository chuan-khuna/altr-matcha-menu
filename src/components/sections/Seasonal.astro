---
import { getLiveSeasons, seasonLayout } from "@/lib/seasonal";

/* Only seasons flagged `live` in seasonal.json, newest first. Every other
   season stays reachable from the archive in the footer. */
const live = await getLiveSeasons();
---

{
  live.length > 0 && (
    <section
      id="seasonal"
      class="page-gutter pt-[calc(var(--nav-h)+3rem)] pb-20"
      aria-label="Seasonal menu"
    >
      {/* The page measure, so a season, the menu under it and the nav above it
          share one left edge and one right edge. What happens inside is the
          season component's own business. */}
      <div class="mx-auto flex max-w-[var(--content-max)] flex-col gap-24">
        {live.map((season) => {
          /* Non-null: getLiveSeasons() drops any row without a component. */
          const SeasonMenu = seasonLayout(season.data.slug)!;
          return <SeasonMenu season={season} headingLevel="h2" />;
        })}
      </div>
    </section>
  )
}
