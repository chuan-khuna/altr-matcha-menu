---
import { getCollection } from 'astro:content';
import MenuCard from '@/components/MenuCard.astro';

const matchas = (await getCollection('matcha')).sort(
  (a, b) => a.data.order - b.data.order
);

const menuCategories = [
  { key: 'clear' as const, label: 'Clear Matcha' },
  { key: 'latte' as const, label: 'Latte Matcha' },
  { key: 'powder' as const, label: 'Powder Matcha' },
];

const grouped = menuCategories
  .map((cat) => ({
    name: cat.label,
    items: matchas
      .filter((b) => b.data.menus[cat.key])
      .map((b) => ({
        blend: b,
        menuItems: Object.entries(b.data.menus[cat.key]!),
      })),
  }))
  .filter((g) => g.items.length > 0);

const getSlug = (id: string) => id.split('/').at(-1)!;
---

<section id="menu" class="menu page-gutter" aria-label="Menu">
  <div class="menu__inner">
    <header class="menu__head fade-up">
      <p class="eyebrow">The menu</p>
      <h2 class="menu__title">By blend, not by drink.</h2>
      <p class="menu__lede mono">
        Each blend is sourced and ground in-house. Drink preparations follow the leaf.
      </p>
    </header>

    {grouped.map((group) => (
      <div class="menu__group">
        <div class="menu__group-head fade-up">
          <h3 class="menu__group-title">{group.name}</h3>
          <span class="menu__count mono">{String(group.items.length).padStart(2, '0')} blends</span>
        </div>

        <ul class="menu__list" role="list">
          {group.items.map(({ blend, menuItems }) => (
            <MenuCard
              blend={blend}
              menuItems={menuItems}
              href={`/matcha/${getSlug(blend.id)}`}
            />
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  /* ── section ─────────────────────────────── */
  .menu {
    padding-block: var(--space-3xl);
    border-top: var(--rule-hairline);
  }
  .menu__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ── header ──────────────────────────────── */
  .menu__head {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-3xl);
    max-width: 42rem;
  }
  .menu__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .menu__lede {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-top: var(--space-sm);
    line-height: 1.6;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  /* ── group ───────────────────────────────── */
  .menu__group + .menu__group { margin-top: var(--space-3xl); }
  .menu__group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: var(--rule-ink);
  }
  .menu__group-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .menu__count {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── responsive ──────────────────────────── */
</style>
