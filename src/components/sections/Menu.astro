---
import { getCollection, type CollectionEntry } from "astro:content";
import MenuCard from "@/components/matcha-info/ui/MenuCard.astro";
import MenuSpecialRow from "@/components/matcha-info/ui/MenuSpecialRow.astro";
import MenuRemark from "@/components/matcha-info/MenuRemark.astro";
import MatchaGallery from "@/components/matcha-info/MatchaGallery.astro";

/* Categories sourced from `matcha` key into each blend's `menus` record by
   their own id, so the JSON id and the schema key are the same string. */
const MATCHA_MENU_KEYS = ["clear", "latte", "powder"] as const;
type MatchaMenuKey = (typeof MATCHA_MENU_KEYS)[number];
const isMatchaMenuKey = (id: string): id is MatchaMenuKey =>
  (MATCHA_MENU_KEYS as readonly string[]).includes(id);

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const categories = (await getCollection("menuCategories")).sort(byOrder);
const matchas = (await getCollection("matcha")).sort(byOrder);
const dessertGroups = (await getCollection("desserts")).sort(byOrder);

const getSlug = (id: string) => id.split("/").at(-1)!;

type MenuGroup =
  | {
      kind: "matcha";
      category: CollectionEntry<"menuCategories">;
      blends: {
        blend: CollectionEntry<"matcha">;
        menuItems: [string, number][];
        href: string;
      }[];
    }
  | {
      kind: "desserts";
      category: CollectionEntry<"menuCategories">;
      dessertGroups: CollectionEntry<"desserts">[];
    };

/* A category with nothing to price is not rendered — that covers `powder` while
   its prices are commented out of the blends, and `teawear`, which is configured
   with photographs but has no collection behind it yet. */
const groups: MenuGroup[] = categories.flatMap((category): MenuGroup[] => {
  if (category.data.source === "matcha" && isMatchaMenuKey(category.id)) {
    const key = category.id;
    const blends = matchas
      .filter((b) => Object.keys(b.data.menus[key] ?? {}).length > 0)
      .map((b) => ({
        blend: b,
        menuItems: Object.entries(b.data.menus[key]!),
        href: `/matcha/${getSlug(b.id)}`,
      }));
    return blends.length > 0 ? [{ kind: "matcha", category, blends }] : [];
  }

  if (category.data.source === "desserts") {
    const withItems = dessertGroups.filter((g) => g.data.items.length > 0);
    return withItems.length > 0
      ? [{ kind: "desserts", category, dessertGroups: withItems }]
      : [];
  }

  return [];
});

/* Keep the lede honest as the harvest changes rather than hard-coding a count. */
const NUMBER_WORDS = [
  "no", "one", "two", "three", "four", "five", "six",
  "seven", "eight", "nine", "ten", "eleven", "twelve",
];
const spell = (n: number) => NUMBER_WORDS[n] ?? String(n);

const dessertBlends = dessertGroups.filter((g) => g.data.items.length > 0).length;

/* Composed here, not inline in the markup — an inline conditional puts a newline
   in front of the comma and the browser collapses it to a visible space. */
const lede = [
  `We are pouring ${spell(matchas.length)} matcha this harvest`,
  dessertBlends > 0
    ? `, and ${spell(dessertBlends)} blend${dessertBlends === 1 ? "" : "s"} kept back for dessert`
    : "",
  ". Matcha names link through to the sourcing note — cultivar, garden, shading, mill.",
].join("");

/* Rendered width of the gallery rail, in px — matches --menu-cat-img-lg (17rem)
   so Astro emits a sized image instead of the full-resolution original. */
const RAIL_IMAGE_PX = 272;
---

<section
  id="menu"
  class="page-gutter border-t border-border py-16"
  aria-label="Menu"
>
  <div class="mx-auto max-w-[var(--content-max)]">
    <div class="max-w-[var(--menu-measure)]">
      <!-- Index-First opens on a paragraph, not a display headline -->
      <header class="mb-16 max-w-[48ch]">
        <p class="mono text-md leading-snug text-ink">{lede}</p>
        <p class="mono mt-4 text-sm leading-normal text-ink-muted">
          Prices in baht, per serving. Blends change with the harvest, so this page
          changes with them.
        </p>
      </header>

      {
        groups.map((group) => {
          const { label, gloss, gallery, sweetnessScale } = group.category.data;
          const headId = `menu-${group.category.id}`;
          const hasGallery = !!gallery && gallery.length > 0;
          return (
            <section class="pb-20 last:pb-0" aria-labelledby={headId}>
              {/* S4 · category head — the full measure, label above gloss. The
                  rule under it is what everything below belongs to. Pins under
                  the nav from 46rem up, where the gloss still sets on one line;
                  below that the head plus the nav would eat too much of a phone
                  screen. bg-paper so the entries pass behind it, and z-20 because
                  the photo rail is a later positioned sibling that would
                  otherwise paint over it. */}
              <header class="border-b border-ink pt-2 pb-2 min-[46rem]:sticky min-[46rem]:top-[var(--nav-h)] min-[46rem]:z-20 min-[46rem]:bg-paper">
                <h2
                  id={headId}
                  data-optical
                  class="display text-lg leading-tight tracking-snug text-ink"
                >
                  {label}
                </h2>
                {gloss && (
                  <p class="display mt-1 text-md italic leading-snug text-ink-muted">
                    {gloss}
                  </p>
                )}
              </header>

              <div
                class:list={[
                  "mt-8",
                  hasGallery &&
                    "min-[62rem]:grid min-[62rem]:grid-cols-[var(--menu-cat-img-lg)_minmax(0,1fr)] min-[62rem]:items-start min-[62rem]:gap-x-12",
                ]}
              >
                {/* One photograph or several — the crossfading gallery from the
                    blend pages, on the paper. No frame, no radius, no shadow. It
                    travels down with the entries it belongs to, from 62rem up. */}
                {hasGallery && (
                  <div class="w-[var(--menu-cat-img)] min-[62rem]:sticky min-[62rem]:top-[calc(var(--nav-h)+var(--menu-head-h)+var(--space-lg))] min-[62rem]:z-10 min-[62rem]:w-full min-[62rem]:self-start">
                    <MatchaGallery
                      items={gallery!}
                      imageWidth={RAIL_IMAGE_PX}
                      fit="cover"
                      animate={false}
                    />
                  </div>
                )}

                <div class="mt-10 min-w-0 min-[62rem]:mt-0">
                  {group.kind === "matcha" ? (
                    <ul class="m-0 list-none divide-y divide-rule p-0" role="list">
                      {group.blends.map(({ blend, menuItems, href }) => (
                        <MenuCard blend={blend} menuItems={menuItems} href={href} />
                      ))}
                    </ul>
                  ) : (
                    group.dessertGroups.map((dessert) => (
                      <div class="[&+div]:mt-10">
                        {/* The blend the whole category is built on. Named only
                            when there is more than one — with a single blend the
                            category head has already said it. */}
                        {group.dessertGroups.length > 1 && (
                          <p class="mono text-sm text-ink-muted">{dessert.data.name}</p>
                        )}
                        {dessert.data.notes && dessert.data.notes.length > 0 && (
                          <p class="mono text-base leading-snug text-ink">
                            {dessert.data.notes.join(" · ")}
                          </p>
                        )}
                        <ul class="m-0 mt-4 list-none divide-y divide-rule p-0" role="list">
                          {dessert.data.items.map((item) => (
                            <MenuSpecialRow
                              name={item.name}
                              price={item.price}
                              description={item.description}
                              image={item.image}
                              imageAlt={item.imageAlt}
                            />
                          ))}
                        </ul>
                      </div>
                    ))
                  )}

                  {sweetnessScale && (
                    <div class="mt-8 border-t border-rule pt-6">
                      <MenuRemark />
                    </div>
                  )}
                </div>
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</section>
