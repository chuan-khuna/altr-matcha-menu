---
import { getCollection } from "astro:content";
import MenuCard from "@/components/matcha-info/ui/MenuCard.astro";

const matchas = (await getCollection("matcha")).sort(
  (a, b) => a.data.order - b.data.order,
);

const menuCategories = [
  { key: "clear" as const, label: "Clear Matcha" },
  { key: "latte" as const, label: "Latte Matcha" },
  { key: "powder" as const, label: "Powder" },
];

const grouped = menuCategories
  .map((cat) => ({
    name: cat.label,
    items: matchas
      .filter((b) => b.data.menus[cat.key])
      .map((b) => ({
        blend: b,
        menuItems: Object.entries(b.data.menus[cat.key]!),
      })),
  }))
  .filter((g) => g.items.length > 0);

const getSlug = (id: string) => id.split("/").at(-1)!;
---

<section
  id="menu"
  class="page-gutter border-t border-border py-16"
  aria-label="Menu"
>
  <div class="mx-auto max-w-[var(--content-max)] field-grid">
    <header class="col-span-12 mb-12 min-[800px]:col-span-8">
      <h2
        class="display text-display-s italic leading-tight tracking-snug"
      >
        Three preparations.
      </h2>
      <p
        class="mono mt-2 text-sm leading-normal tracking-normal text-ink-muted"
      >
        Each blend is sourced and ground in-house. Drink preparations follow the
        leaf.
      </p>
    </header>

    {
      grouped.map((group) => (
        <div class="col-span-12 mt-16 first:mt-0">
          <div class="border-b border-border pb-4">
            <h3 class="display text-xl italic">{group.name}</h3>
          </div>
          <ul class="m-0 list-none p-0" role="list">
            {group.items.map(({ blend, menuItems }) => (
              <MenuCard
                blend={blend}
                menuItems={menuItems}
                href={`/matcha/${getSlug(blend.id)}`}
              />
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
