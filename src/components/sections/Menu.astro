---
import { getCollection } from 'astro:content';

const matchaDrinks = (await getCollection('matchaDrinks')).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = ['Clear Matcha', 'Latte Matcha', 'Powder Matcha'] as const;
const grouped = categories
  .map((cat) => ({
    name: cat,
    items: matchaDrinks.filter((b) => b.data.category === cat),
  }))
  .filter((g) => g.items.length > 0);

const formatPrice = (n: number) => (n > 0 ? `฿${n}` : '—');
---

<section id="menu" class="menu page-gutter" aria-label="Menu">
  <div class="menu__inner">
    <header class="menu__head fade-up">
      <p class="eyebrow">The menu</p>
      <h2 class="menu__title">By blend, not by drink.</h2>
      <p class="menu__lede mono">
        Each blend is sourced and ground in-house. Drink preparations follow the leaf.
      </p>
    </header>

    {grouped.map((group) => (
      <div class="menu__group">
        <div class="menu__group-head fade-up">
          <h3 class="menu__group-title">{group.name}</h3>
          <span class="menu__count mono">{String(group.items.length).padStart(2, '0')} blends</span>
        </div>

        <ul class="menu__list" role="list">
          {group.items.map((blend) => (
            <li class="blend fade-up">
              <a
                href={`/matcha-drinks/${blend.id}`}
                class="blend__link"
                aria-label={`${blend.data.name} — full blend profile`}
              >
                <div class="blend__head">
                  <h4 class="blend__name">{blend.data.name}</h4>
                  {blend.data.info?.origin && (
                    <p class="blend__origin mono">{blend.data.info.origin}</p>
                  )}
                </div>

                <ul class="blend__notes" role="list" aria-label="Cupping notes">
                  {blend.data.cuppingNotes.map((note) => (
                    <li class="blend__note">{note}</li>
                  ))}
                </ul>

                <div class="blend__drinks mono">
                  {blend.data.drinks.map((d) => (
                    <div class="blend__row">
                      <span class="blend__drink">{d.name}</span>
                      <span class="blend__dots" aria-hidden="true"></span>
                      <span class="blend__price">{formatPrice(d.price)}</span>
                    </div>
                  ))}
                </div>

                <span class="blend__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  /* ── section ─────────────────────────────── */
  .menu {
    padding-block: var(--space-3xl);
    border-top: var(--rule-hairline);
  }
  .menu__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  /* ── header ──────────────────────────────── */
  .menu__head {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-3xl);
    max-width: 42rem;
  }
  .menu__title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .menu__lede {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-top: var(--space-sm);
    line-height: 1.6;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  /* ── group ───────────────────────────────── */
  .menu__group + .menu__group { margin-top: var(--space-3xl); }
  .menu__group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: var(--rule-ink);
  }
  .menu__group-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }
  .menu__count {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── horizontal blend row ────────────────── */
  .blend {
    border-bottom: var(--rule-hairline);
  }
  .blend__link {
    display: grid;
    grid-template-columns: minmax(150px, 22%) 1fr minmax(200px, 30%) 1.25rem;
    grid-template-areas: "head notes drinks arrow";
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
    color: inherit;
  }
  .blend__link:hover { color: inherit; }

  /* ── name + origin ───────────────────────── */
  .blend__head { grid-area: head; }
  .blend__name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.05;
  }
  .blend__origin {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: var(--space-2);
  }

  /* ── cupping note chips ──────────────────── */
  .blend__notes {
    grid-area: notes;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-content: flex-start;
  }
  .blend__note {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    background: color-mix(in oklch, var(--primary) 14%, var(--background));
    color: var(--color-ink-muted);
    text-transform: lowercase;
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }
  .blend:hover .blend__note {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  /* ── drinks + prices ─────────────────────── */
  .blend__drinks {
    grid-area: drinks;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }
  .blend__row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .blend__drink { color: var(--color-ink); }
  .blend__dots {
    flex: 1;
    border-bottom: 1px dotted var(--color-sand);
    transform: translateY(-3px);
  }
  .blend__price {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  /* ── arrow ───────────────────────────────── */
  .blend__arrow {
    grid-area: arrow;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-ink-muted);
    justify-self: end;
    transition: transform var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }
  .blend:hover .blend__arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  /* ── responsive ──────────────────────────── */
  @media (max-width: 640px) {
    .blend__link {
      grid-template-columns: 1fr 1.25rem;
      grid-template-rows: auto auto auto;
      grid-template-areas:
        "head   arrow"
        "notes  notes"
        "drinks drinks";
      gap: var(--space-md);
    }
    .blend__arrow { align-self: start; }
  }
</style>
