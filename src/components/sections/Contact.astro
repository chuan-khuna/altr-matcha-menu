---
import { address, hours, reach } from '@/data/site';
---
<section id="contact" class="page-gutter border-t border-border py-[var(--space-3xl)]" aria-label="Visit ALTR">
  <div class="mx-auto max-w-[var(--content-max)]">
    <header class="fade-up mb-[var(--space-3xl)] max-w-[36rem]">
      <p class="eyebrow">Visit</p>
      <h2 class="display mt-[var(--space-sm)] text-[clamp(2.25rem,5.5vw,4rem)] italic leading-[1.05] tracking-[-0.015em]">Find us, before the leaf turns.</h2>
    </header>

    <div class="grid grid-cols-1 gap-0 border-t border-foreground min-[800px]:grid-cols-[1.2fr_1fr_1fr]">
      <div class="fade-up grid gap-[var(--space-md)] border-b border-border py-[var(--space-xl)] min-[800px]:border-r min-[800px]:border-border min-[800px]:pr-[var(--space-xl)]">
        <p class="mono text-[var(--text-xs)] uppercase tracking-[0.18em] text-accent">Address</p>
        <address class="display text-[var(--text-xl)] not-italic leading-[1.35] text-ink">
          {address.line1}<br />
          {address.line2}<br />
          {address.city}
        </address>
        <a href={address.mapsHref} class="mono justify-self-start text-[var(--text-xs)] uppercase tracking-[0.14em] text-ink-muted hover:text-accent" target="_blank" rel="noopener noreferrer">
          Open in Google Maps →
        </a>
      </div>

      <div class="fade-up grid gap-[var(--space-md)] border-b border-border py-[var(--space-xl)] min-[800px]:border-r min-[800px]:border-border min-[800px]:px-[var(--space-xl)]">
        <p class="mono text-[var(--text-xs)] uppercase tracking-[0.18em] text-accent">Hours</p>
        <table class="mono border-collapse text-[var(--text-sm)]">
          <tbody>
            {hours.map((row) => (
              <tr>
                <th scope="row" class="px-0 py-[var(--space-2)] pr-[var(--space-lg)] text-left align-baseline text-[var(--text-xs)] font-normal uppercase tracking-[0.08em] text-ink-muted">{row.day}</th>
                <td class="px-0 py-[var(--space-2)] text-ink tabular-nums">{row.open}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="fade-up grid gap-[var(--space-md)] border-b border-border py-[var(--space-xl)] min-[800px]:pl-[var(--space-xl)]">
        <p class="mono text-[var(--text-xs)] uppercase tracking-[0.18em] text-accent">Reach</p>
        <ul class="mono m-0 grid list-none gap-[var(--space-sm)] p-0 text-[var(--text-sm)]">
          {reach.map((item) => (
            <li>
              <a class="border-b border-sand text-ink hover:border-accent hover:text-accent" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                {item.display}
              </a>
              <span class="ml-[var(--space-2)] text-ink-muted">— {item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
