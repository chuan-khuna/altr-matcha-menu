---
import { address, hours, reach } from '@/data/site';
---
<section id="contact" class="page-gutter border-t border-border py-16" aria-label="Visit ALTR">
  <div class="mx-auto max-w-[var(--content-max)]">
    <h2 class="display mb-8 text-[clamp(2rem,4vw,3.25rem)] italic leading-[1.1] tracking-[-0.015em]">Visit.</h2>

    <div class="grid grid-cols-1 gap-10 font-sans text-base leading-[1.8] min-[640px]:grid-cols-3 min-[640px]:gap-12">
      <div>
        <p class="mono mb-2 text-xs uppercase tracking-[0.16em] text-ink-muted">Address</p>
        <address class="not-italic text-ink">
          {address.line1}<br />
          {address.line2}<br />
          {address.city}
        </address>
        <a href={address.mapsHref} class="mono mt-3 inline-block text-xs uppercase tracking-[0.12em] text-ink-muted hover:text-accent transition-colors duration-150" target="_blank" rel="noopener noreferrer">
          Open in Google Maps →
        </a>
      </div>

      <div>
        <p class="mono mb-2 text-xs uppercase tracking-[0.16em] text-ink-muted">Hours</p>
        <ul class="m-0 list-none p-0 text-ink">
          {hours.map((row) => (
            <li class="grid grid-cols-[6rem_1fr] gap-2">
              <span class="text-ink-muted">{row.day}</span>
              <span>{row.open}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mono mb-2 text-xs uppercase tracking-[0.16em] text-ink-muted">Reach</p>
        <ul class="mono m-0 grid list-none gap-3 p-0 text-sm">
          {reach.map((item) => (
            <li>
              <a class="border-b border-sand text-ink hover:border-accent hover:text-accent transition-colors duration-150" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                {item.display}
              </a>
              <span class="ml-2 text-ink-muted">— {item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
