---
import type { CollectionEntry } from 'astro:content';

interface Props {
  blend: CollectionEntry<'matcha'>;
  menuItems: [string, number][];
  href: string;
}

const { blend, menuItems, href } = Astro.props;
const d = blend.data;

const formatPrice = (n: number) => (n > 0 ? `฿${n}` : '—');
---

<li class="group fade-up border-b border-border">
  <a
    href={href}
    class="flex items-start justify-between gap-12 py-8 text-inherit hover:text-inherit max-sm:flex-col max-sm:gap-4"
    aria-label={`${d.name} — full blend profile`}
  >
    <div class="flex min-w-0 flex-1 flex-col gap-2">
      <h4 class="display text-2xl italic leading-[1.05]">{d.name}</h4>
      {d.info?.brand && <p class="mono text-xs tracking-[0.08em] text-ink-muted">by {d.info.brand}</p>}
      {d.info?.origin && <p class="mono text-xs uppercase tracking-[0.12em] text-accent">{d.info.origin}</p>}
      <ul class="mt-3 flex list-none flex-wrap gap-2 p-0" role="list" aria-label="Cupping notes">
        {d.notes.map((note) => (
          <li class="mono bg-[color-mix(in_oklch,var(--primary)_14%,var(--background))] px-[8px] py-[3px] text-[0.68rem] lowercase tracking-[0.06em] text-ink-muted transition-colors duration-150 ease-out group-hover:bg-primary group-hover:text-primary-foreground">{note}</li>
        ))}
      </ul>
    </div>

    <div class="flex shrink-0 flex-col items-end gap-3 max-sm:w-full max-sm:items-start">
      <div class="mono grid min-w-[14rem] gap-1 text-sm max-sm:w-full max-sm:min-w-0">
        {menuItems.map(([name, price]) => (
          <div class="flex items-baseline gap-2">
            <span class="text-ink">{name}</span>
            <span class="flex-1 translate-y-[-3px] border-b border-dotted border-sand" aria-hidden="true"></span>
            <span class="tabular-nums text-ink">{formatPrice(price)}</span>
          </div>
        ))}
      </div>
      <span class="mono text-sm text-ink-muted transition-all duration-150 ease-out group-hover:translate-x-[4px] group-hover:text-accent" aria-hidden="true">→</span>
    </div>
  </a>
</li>
