---
import { address, hours, reach } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="page-gutter pb-16 pt-0">
  <div class="mx-auto max-w-[var(--content-max)]">
    <div class="border-t border-foreground pt-10">
      <p class="display text-2xl italic leading-[1.3] text-ink">
        Yours,<br />
        <span class="display not-italic">— ALTR.</span>
      </p>
      <p class="mono mt-6 text-xs leading-[1.9] tracking-[0.04em] text-ink-muted">
        {address.line1} · {address.line2} · {address.city}<br />
        {hours.map((r, i) => `${r.day} ${r.open}${i < hours.length - 1 ? ' · ' : ''}`).join('')}
      </p>
      <p class="mono mt-4 text-xs tracking-[0.04em] text-ink-muted">
        P.S. —&nbsp;
        {reach.map((item, i) => (
          <>
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="border-b border-sand hover:border-accent hover:text-accent transition-colors duration-150"
            >{item.display}</a>
            {i < reach.length - 1 && <span class="text-sand mx-2">·</span>}
          </>
        ))}
        <span class="ml-3 text-sand">· {year}</span>
      </p>
    </div>
  </div>
</footer>
