---
import { nav } from '@/data/site';

interface Props {
  showBack?: boolean;
}
const { showBack = false } = Astro.props;
---
<nav class="nav page-gutter">
  <div class="nav__inner">
    <a href="/" class="nav__wordmark" aria-label="ALTR — home">ALTR</a>
    {showBack ? (
      <a href="/#menu" class="nav__back mono">← Back to menu</a>
    ) : (
      <ul class="nav__links mono">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    )}
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-h);
    background: color-mix(in oklch, var(--color-paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: var(--rule-hairline);
    z-index: 50;
  }
  .nav__inner {
    height: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }
  .nav__wordmark {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
  .nav__wordmark:hover { color: var(--color-accent); }
  .nav__links {
    list-style: none;
    display: flex;
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .nav__back {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  @media (max-width: 480px) {
    .nav__links { gap: var(--space-md); }
  }
</style>
